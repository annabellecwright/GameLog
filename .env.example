# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# These are only needed when you run `npm run add` or `npm run enrich`,
# which look up cover art and descriptions from IGDB.
# The published site never uses them -- it only reads data/collection.json.
#
# Get them free in about two minutes:
#   1. Go to https://dev.twitch.tv/console/apps and log in
#   2. "Register Your Application"
#        Name:          anything (e.g. "GameLog")
#        OAuth Redirect URL:  http://localhost
#        Category:      Application Integration
#        Client Type:   Confidential
#   3. Copy the Client ID, then "New Secret" and copy that too

IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
